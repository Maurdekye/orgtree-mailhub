# Copy to .env (docker compose reads it). All values optional except HUB_DB_PASSWORD.
# REQUIRED (v2): the password of the hub's own PostgreSQL service. Any long random string;
# the database is reachable only from the hub's container. Changing it after the first
# start needs the database's password changed too (it is set when the volume is created).
HUB_DB_PASSWORD=
# The hub's display name, discovered by clients on connect. Default: container hostname.
HUB_NAME=
# Days undelivered mail and attachment blobs are kept (default 30).
HUB_RETENTION_DAYS=
HUB_MAX_FILE_BYTES=1073741824
# Days a silent client stays on the roster (default 45; never below message retention).
HUB_ORG_RETENTION_DAYS=
# Set to 1 to serve the API-only public listener on internal port 7371 (FR-10).
HUB_PUBLIC=
# Host interface for the FULL app (port 7370, includes the unauthenticated all-mail UI).
# Default 0.0.0.0; set 127.0.0.1 once every remote client uses the public port below.
HUB_BIND=
# Host interface for the API-only public listener's mapping (default 0.0.0.0).
# Set 127.0.0.1 to keep it loopback-only behind a tunnel or reverse proxy.
HUB_PUBLIC_BIND=
# Host port mapped to the API-only public listener (default 7378). A BARE port —
# the interface comes from HUB_PUBLIC_BIND, never from an IP written here.
HUB_PUBLIC_HOST_PORT=
# Container names (defaults orgtree-mailhub and orgtree-mailhub-db). Container names are
# host-global: a second instance on the same host must set its own, plus its own compose
# project (-p) for distinct volumes and its own host ports above.
HUB_CONTAINER_NAME=
HUB_DB_CONTAINER_NAME=
